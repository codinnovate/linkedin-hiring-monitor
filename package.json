{
  "name": "linkedin-hiring-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor LinkedIn posts for hiring content, classify with AI, and notify users.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node api.js && pnpm -r build",
    "dev": "node api.js && pnpm --parallel --filter @lhm/database --filter @lhm/shared build && pnpm --parallel -r dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @lhm/database generate",
    "db:migrate": "pnpm --filter @lhm/database migrate",
    "db:deploy": "pnpm --filter @lhm/database deploy",
    "db:studio": "pnpm --filter @lhm/database studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "playwright:install": "pnpm --filter @lhm/worker exec playwright install chromium",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  }
}
