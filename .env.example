# =============================================================
# Linkedin Hiring Monitor — Environment Variables
# Copy to .env and fill in real values. Never commit .env files.
# =============================================================

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info

# --- Postgres (docker/docker-compose.yml defaults) ---
DATABASE_URL=postgresql://lhm:lhm_password@localhost:5432/lhm?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth (BetterAuth) ---
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=

# --- Playwright / LinkedIn ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
# Comma separated "host:port" proxy list, e.g. "127.0.0.1:8080,127.0.0.1:8081"
PROXY_LIST=
PROXY_ROTATE=true
# Path to a file containing one user-agent string per line
USER_AGENT_POOL=
# Path to a file containing one LinkedIn session cookie per line (JSON)
LINKEDIN_COOKIES_FILE=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
WORKER_CONCURRENCY=2
WORKER_MAX_JOBS_PER_RUN=10

# --- Scheduler ---
SEARCH_CRON="*/5 * * * *"
MAX_SCROLL_PAGES=30
SCROLL_TIMEOUT_MS=60000
SEARCH_TIMEOUT_MS=120000

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
DISCORD_WEBHOOK_URLS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LinkedIn Hiring Monitor <no-reply@example.com>"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Test ---
TEST_DATABASE_URL=postgresql://lhm:lhm_password@localhost:5432/lhm_test?schema=public
